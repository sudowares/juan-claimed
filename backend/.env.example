# Copy to backend/.env and fill in. `.env` is gitignored — every dev needs their own.
#
# When running via `docker compose`, DATABASE_URL/BACKEND_PORT set in docker-compose.yml
# override whatever is here — but this file still has to EXIST, because Prisma's config
# loader errors if it's missing, and commands run outside Docker (npx prisma studio, the
# test suite, editor tooling) read it directly.

# --- Required: the app will not start without these ---------------------------------

# Inside Docker Compose the host is the `postgres` service; outside it, localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Signs and verifies the Bearer tokens issued by /api/auth/login. Any non-empty string
# works locally; use a long random value in a deployed environment.
JWT_SECRET="change-me-locally"

# --- Optional: features degrade to a clear error if unset ----------------------------

BACKEND_PORT=4000

# Google sign-in (POST /api/auth/google). Without it, that route rejects every token.
GOOGLE_CLIENT_ID=""

# eGovPH SSO (POST /api/auth/egov).
EGOV_BASE_URL=""
EGOV_PARTNER_CODE=""
EGOV_PARTNER_SECRET=""
EGOV_EVERIFY_CLIENT_ID=""
EGOV_EVERIFY_CLIENT_SECRET=""
EGOV_EVERIFY_PUBKEY=""

# Auto-translate while authoring (POST /api/translate).
EGOV_AI_CORE_BASE_URL=""
EGOV_AI_ACCESS_CODE=""

# eMessage SMS push — the "a new benefit you may qualify for" notification. Leave the base
# URL blank to skip sending entirely (benefitNotification.service.ts checks for it) rather
# than logging a failure per eligible user on every benefit create.
EGOV_MESSAGE_BASE_URL=""
EGOV_EMESSAGE_ACCESS_TOKEN=""

# Vercel Blob, for attachment uploads (POST /api/attachments/upload-token). Vercel injects
# this automatically once a Blob store is linked to the project; set it by hand only for
# local upload testing.
BLOB_READ_WRITE_TOKEN=""

# Seeds the demo Superadmin/Agent/USER personas (password: password123). Leave unset in
# any deployed environment.
SEED_DEMO_PERSONAS=true
