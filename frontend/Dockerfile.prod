# Production frontend: multi-stage build.
#   Stage 1 (build)  — Node compiles the app to static files (dist/).
#   Stage 2 (serve)  — tiny nginx image serves those files. No Node at runtime.
# Result: final image is ~small nginx + static assets, not a Node dev server.
#
# Build context is the REPO ROOT, not ./frontend (see .github/workflows/deploy.yml's
# `context: .` for this build) — every path below is repo-root-relative, and that's what
# lets the final stage also pull in the top-level docs/ folder. See the last COPY below.

# --- Stage 1: build ---
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ .

# Vite bakes env vars into the bundle AT BUILD TIME (not runtime). So the backend URL must be
# passed here as a build arg, promoted to an env var Vite can read. Change it per deployment.
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
# "true" unlocks eGovField fields for a Google-only session (see lib/egov-field-lock.ts).
# Build-time only — a runtime .env value can't change it once the bundle is baked.
ARG VITE_UNLOCK_GOOGLE_SYNCED_FIELDS
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_UNLOCK_GOOGLE_SYNCED_FIELDS=$VITE_UNLOCK_GOOGLE_SYNCED_FIELDS

RUN npm run build

# --- Stage 2: serve ---
FROM nginx:alpine

# SPA fallback config (every route -> index.html), replaces the Vercel vercel.json rewrite.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Only the built static output crosses over from the build stage.
COPY --from=build /app/dist /usr/share/nginx/html

# System architecture docs — copied fresh from the repo's own docs/ on every image build,
# so this can never drift the way a hand-maintained frontend/public copy could. Lands at
# /usr/share/nginx/html/docs, a plain sibling of index.html — served by nginx.conf's normal
# static-file handling, no extra location block needed. Reachable at /docs/architecture.html.
COPY docs /usr/share/nginx/html/docs

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
